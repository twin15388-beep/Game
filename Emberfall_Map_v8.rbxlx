GameData.SpellById = {}
for _, s in ipairs(GameData.Spells) do
	GameData.SpellById[s.id] = s
end

function GameData.SpellsForElement(element)
	local out = {}
	for _, s in ipairs(GameData.Spells) do
		if s.element == element then table.insert(out, s) end
	end
	return out
end

