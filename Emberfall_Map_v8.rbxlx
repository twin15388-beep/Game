		desc = "Торговец ищет шкуры для пошива. Принеси 4 шкуры из Глумвуда.",
		objectives = { { type = "collect", target = "M_Pelt", count = 4, text = "Собрать шкур" } },
		rewards = { xp = 220, coins = 120, items = { { id = "W_ShortSword", count = 1 } } },
